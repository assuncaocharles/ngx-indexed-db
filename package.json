{
  "name": "ngx-indexed-db",
  "version": "23.1.1",
  "files": [
    "dist/ngx-indexed-db/**/*"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:playground": "ng serve --project playground",
    "start:ssr-playground": "ng serve --project ssr-playground",
    "build:lib": "ng build --project ngx-indexed-db -c production",
    "watch:lib": "ng build --project ngx-indexed-db -c development",
    "build:playground": "ng build --project playground",
    "build:library": "ng build --project ngx-indexed-db",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier \"projects/**/*.{ts,json}\" --write",
    "serve:ssr:ssr-playground": "node dist/ssr-playground/server/server.mjs",
    "docs:content": "node projects/docs/scripts/build-content.mjs",
    "docs:start": "npm run docs:content && ng serve docs",
    "docs:build": "npm run docs:content && ng build docs && node projects/docs/scripts/postbuild.mjs",
    "docs:og": "node projects/docs/scripts/og-image.mjs"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "prettier --write"
    ],
    "*.{css}": [
      "prettier --write"
    ],
    "projects/ngx-indexed-db/**/*.{tsx,js}": [
      "ng lint"
    ]
  },
  "dependencies": {
    "@angular/animations": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/platform-browser-dynamic": "^22.3.0",
    "@angular/platform-server": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@angular/ssr": "^22.3.0",
    "express": "^4.22.1",
    "rxjs": "^7.0.0",
    "tslib": "^2.0.0",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@commitlint/config-conventional": "^12.1.4",
    "@types/express": "^4.17.25",
    "@types/node": "^24.10.7",
    "@vitest/browser-playwright": "^5.1.2",
    "angular-eslint": "^22.8.0",
    "commitlint": "^12.1.4",
    "cz-conventional-changelog": "3.2.0",
    "eslint": "^9.39.2",
    "husky": ">=4",
    "lint-staged": "^16.2.7",
    "marked": "^18.2.0",
    "playwright": "^1.65.1",
    "prettier": "2.1.1",
    "shiki": "^4.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.0.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS",
      "pre-commit": "lint-staged"
    }
  },
  "types": "dist/ngx-indexed-db/lib/ngx-indexed-db.meta.d.ts"
}
