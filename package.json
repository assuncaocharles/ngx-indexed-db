{
  "name": "ngx-indexed-db",
  "version": "22.0.0",
  "files": [
    "dist/ngx-indexed-db/**/*"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.15.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:playground": "ng serve --project playground",
    "start:ssr-playground": "ng serve --project ssr-playground",
    "build:lib": "ng build --project ngx-indexed-db -c production",
    "watch:lib": "ng build --project ngx-indexed-db -c development",
    "build:playground": "ng build --project playground",
    "build:library": "ng build --project ngx-indexed-db",
    "test": "ng test --project ngx-indexed-db",
    "lint": "ng lint",
    "format": "prettier \"projects/**/*.{ts,json}\" --write",
    "serve:ssr:ssr-playground": "node dist/ssr-playground/server/server.mjs",
    "test:all": "ng test"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "prettier --write"
    ],
    "*.{css}": [
      "prettier --write"
    ],
    "projects/ngx-indexed-db/**/*.{tsx,js}": [
      "ng lint"
    ]
  },
  "dependencies": {
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/platform-server": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@angular/ssr": "^22.2.1",
    "express": "^5.2.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "angular-eslint": "^22.5.0",
    "commitlint": "^21.2.3",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.12.0",
    "fake-indexeddb": "^6.2.5",
    "husky": ">=4",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "ng-packagr": "^22.2.4",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS",
      "pre-commit": "lint-staged"
    }
  },
  "types": "dist/ngx-indexed-db/types/ngx-indexed-db.d.ts"
}
